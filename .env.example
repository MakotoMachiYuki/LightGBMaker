# =============================================================================
# LightGBMaker – Example Environment Configuration
# Copy this file to `.env` and fill in your private API keys before running.
# =============================================================================

CARTO_API_KEY=your_carto_api_key_here
CARTO_BASEMAP_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png

DATA_PATH=Dataset/ookla_indonesia_only.parquet
EXCEL_EVAL_PATH=Dataset/evaluasi_metrik_lightgbm.xlsx
MODEL_BUNDLE_80_20_PATH=Dataset/lightgbm_ookla_bundle_80_20.pkl
MODEL_BUNDLE_70_30_PATH=Dataset/lightgbm_ookla_bundle_70_30.pkl
MODEL_BUNDLE_MAIN_PATH=Dataset/lightgbm_ookla_bundle.pkl
GDB_PATH=Dataset/RBI50K_ADMINISTRASI_KABKOTA_20230907.gdb

RANDOM_STATE=727
K_FOLDS=5
EARLY_STOPPING=50
MAP_SAMPLE_PER_YEAR=15000
